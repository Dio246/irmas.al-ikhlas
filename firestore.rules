rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Galeri dokumentasi bersama publik IRMAS Masjid Jamie Al-Ikhlas
    // Siapa saja (jamaah/pengurus dari HP atau Laptop) dapat membaca dokumentasi kegiatan
    // dan menambahkan/mengupdate dokumentasi kegiatan
    match /gallery_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Health-check / connection validation document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
