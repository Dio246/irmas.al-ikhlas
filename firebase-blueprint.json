{
  "entities": {
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Dokumentasi kegiatan IRMAS Masjid Jamie Al-Ikhlas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "participants": { "type": "number" },
        "highlight": { "type": "boolean" },
        "driveUrl": { "type": "string" },
        "driveFolderUrl": { "type": "string" },
        "driveFileId": { "type": "string" },
        "driveFileIds": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "category", "imageUrl"]
    }
  },
  "firestore": {
    "/gallery_items/{itemId}": {
      "schema": "#/entities/GalleryItem",
      "description": "Koleksi foto dokumentasi kegiatan IRMAS Masjid Jamie Al-Ikhlas lintas semua perangkat"
    }
  }
}
